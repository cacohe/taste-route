# OpenAI 兼容 LLM（厂商中立，无默认服务商）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://your-openai-compatible-endpoint.example/v1
LLM_MODEL=your_model_name_here
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=1

# Qloo Hackathon API（仅服务端使用）
QLOO_API_KEY=your_qloo_hackathon_api_key_here
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
QLOO_TIMEOUT_SECONDS=15
QLOO_MAX_RESULTS=20

# Bounded agent planning
AGENT_MAX_DECISIONS=8
QLOO_NEARBY_RADIUS_METERS=10000

# Process-local public demo safeguards
SEARCH_RATE_LIMIT_PER_MINUTE=30
PLAN_RATE_LIMIT_PER_MINUTE=5
PLAN_MAX_CONCURRENCY=3
SEARCH_CACHE_TTL_SECONDS=600
PLAN_CACHE_TTL_SECONDS=900

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

